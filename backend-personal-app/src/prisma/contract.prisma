// use prisma-8

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TenantRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProjectRole {
  OWNER
  ADMIN
  DEVELOPER
  REVIEWER
  VIEWER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id           String            @id @default(uuid())
  username     String            @unique
  email        String            @unique
  passwordHash String
  name         String?
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  createdProjects Project[]
  projectMembers    ProjectMember[]
  createdTenants Tenant[]
  tenantMembers TenantMember[]
  createdTasks      Task[]
  knowledgeArticles KnowledgeArticle[]
  codeSnippets CodeSnippet[]
  documents Document[]
}

model Tenant {
  id        String       @id @default(uuid())
  name      String
  createdBy String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  creator User @relation(
    fields: [createdBy],
    references: [id]
  )

  members TenantMember[]
  projects Project[]

  @@index([createdBy])
}

model TenantMember {
  id        String     @id @default(uuid())
  tenantId  String
  userId    String
  role      TenantRole
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  tenant Tenant @relation(
    fields: [tenantId],
    references: [id]
  )

  user User @relation(
    fields: [userId],
    references: [id]
  )

  @@unique([tenantId, userId])
  @@index([userId])
}

model Project {
  id          String             @id @default(uuid())
  name        String
  description String?
  status      ProjectStatus @default(PLANNED)
  createdBy   String
  tenantId    String
  createdAt   TimestamptzString  @default(now())
  updatedAt   temporal.updatedAtString()

  creator User @relation(
  fields: [createdBy],
  references: [id]
)

  tenant Tenant? @relation(
    fields: [tenantId],
    references: [id]
  )

  members ProjectMember[]
  tasks   Task[]
}

model ProjectMember {
  id        String            @id @default(uuid())
  projectId String
  userId    String
  role      ProjectRole
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  project Project @relation(
    fields: [projectId],
    references: [id]
  )

  user User @relation(
    fields: [userId],
    references: [id]
  )

  taskAssignees TaskAssignee[]

  @@unique([projectId, userId])
}
model Task {
  id          String            @id @default(uuid())
  projectId   String
  createdBy   String
  title       String
  description String?
  status   TaskStatus   @default(TODO)
  priority TaskPriority @default(MEDIUM)
  dueDate     TimestamptzString?
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  project   Project @relation(
    fields: [projectId],
    references: [id]
  )

  creator   User @relation(
    fields: [createdBy],
    references: [id]
  )

  assignees TaskAssignee[]

  @@unique([id, projectId])
}

model TaskAssignee {
  id        String            @id @default(uuid())
  taskId    String
  projectId String
  userId    String
  createdAt TimestamptzString @default(now())

  task Task @relation(
    fields: [taskId, projectId],
    references: [id, projectId]
  )

  member ProjectMember @relation(
    fields: [projectId, userId],
    references: [projectId, userId]
  )

  @@unique([taskId, userId])
}

model KnowledgeArticle {
  id          String            @id @default(uuid())
  title       String
  slug        String            @unique
  content     String
  summary     String?
  createdBy   String
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  author User @relation(
    fields: [createdBy],
    references: [id]
  )

  tags KnowledgeArticleTag[]
}

model Tag {
  id        String            @id @default(uuid())
  name      String            @unique
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  knowledgeArticles KnowledgeArticleTag[]
  snippetTags       SnippetTag[]
}

model KnowledgeArticleTag {
  id        String            @id @default(uuid())
  articleId String
  tagId     String
  createdAt TimestamptzString @default(now())

  article KnowledgeArticle @relation(
    fields: [articleId],
    references: [id]
  )

  tag Tag @relation(
    fields: [tagId],
    references: [id]
  )
  

  @@unique([articleId, tagId])
}

model CodeSnippet {
  id          String            @id @default(uuid())
  title       String
  language    String
  code        String
  description String?
  createdBy   String
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  author User @relation(
    fields: [createdBy],
    references: [id]
  )

  tags SnippetTag[]
}

model SnippetTag {
  id        String            @id @default(uuid())
  snippetId String
  tagId     String
  createdAt TimestamptzString @default(now())

  snippet CodeSnippet @relation(
    fields: [snippetId],
    references: [id]
  )

  tag Tag @relation(
    fields: [tagId],
    references: [id]
  )

  @@unique([snippetId, tagId])
}

model Document {
  id          String            @id @default(uuid())
  title       String
  description String?
  fileName    String
  filePath    String
  mimeType    String
  fileSize    String
  createdBy   String
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  creator User @relation(
    fields: [createdBy],
    references: [id]
  )
}
