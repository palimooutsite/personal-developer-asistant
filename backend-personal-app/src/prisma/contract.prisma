// use prisma-8

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TenantRole {
  OWNER
  ADMIN
  MEMBER
}

enum PermissionModule {
  DASHBOARD
  PROJECTS
  TASKS
  KNOWLEDGE
  CODE_SNIPPETS
  DOCUMENTS
  PROJECT_MEMBERS
  WORKSPACE_MEMBERS
  WORKSPACE_SETTINGS
}

model TenantCustomRole {
  id          String            @id @default(uuid())
  tenantId    String
  name        String
  description String?
  isSystem    Boolean           @default(false)
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  tenant      Tenant                  @relation(fields: [tenantId], references: [id])
  members     TenantMember[]
  invitations TenantInvitation[]
  permissions TenantRolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model TenantRolePermission {
  id         String            @id @default(uuid())
  roleId     String
  module     PermissionModule
  canCreate  Boolean           @default(false)
  canRead    Boolean           @default(false)
  canUpdate  Boolean           @default(false)
  canDelete  Boolean           @default(false)
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()

  role TenantCustomRole @relation(fields: [roleId], references: [id])

  @@unique([roleId, module])
  @@index([roleId])
}

enum ProjectRole {
  OWNER
  ADMIN
  DEVELOPER
  REVIEWER
  VIEWER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id           String            @id @default(uuid())
  username     String            @unique
  email        String            @unique
  passwordHash String
  name         String?
  avatarUrl    String?
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  createdProjects Project[]
  projectMembers    ProjectMember[]
  createdTenants Tenant[]
  tenantMembers TenantMember[]
  sentInvitations TenantInvitation[]
  createdTasks      Task[]
  knowledgeArticles KnowledgeArticle[]
  codeSnippets CodeSnippet[]
  documents Document[]
  subscriptions TenantSubscription[]
  invoices SubscriptionInvoice[]
  discountUsages DiscountUsage[]
  payments Payment[]
}

model Tenant {
  id        String       @id @default(uuid())
  name      String
  createdBy String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  creator User @relation(
    fields: [createdBy],
    references: [id]
  )

  members TenantMember[]
  roles TenantCustomRole[]
  invitations TenantInvitation[]
  projects Project[]
  knowledgeArticles KnowledgeArticle[]
  tags Tag[]
  codeSnippets CodeSnippet[]
  documents Document[]
  @@index([createdBy])
}

model TenantMember {
  id        String     @id @default(uuid())
  tenantId  String
  userId    String
  role      TenantRole
  roleId    String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  tenant Tenant @relation(
    fields: [tenantId],
    references: [id]
  )

  user User @relation(
    fields: [userId],
    references: [id]
  )

  customRole TenantCustomRole @relation(fields: [roleId], references: [id])

  @@unique([tenantId, userId])
  @@index([userId])
}


model TenantInvitation {
  id          String            @id @default(uuid())
  tenantId    String
  email       String
  role        TenantRole
  roleId      String
  token       String            @unique
  invitedBy   String
  expiresAt   TimestamptzString
  acceptedAt  TimestamptzString?
  createdAt   TimestamptzString  @default(now())
  updatedAt   temporal.updatedAtString()

  tenant Tenant @relation(
    fields: [tenantId],
    references: [id]
  )

  inviter User @relation(
    fields: [invitedBy],
    references: [id]
  )

  customRole TenantCustomRole @relation(fields: [roleId], references: [id])

  @@index([tenantId])
  @@index([email])
  @@index([expiresAt])
}

model Project {
  id          String             @id @default(uuid())
  name        String
  description String?
  status      ProjectStatus @default(PLANNED)
  createdBy   String
  tenantId    String
  createdAt   TimestamptzString  @default(now())
  updatedAt   temporal.updatedAtString()

  creator User @relation(
  fields: [createdBy],
  references: [id]
)

  tenant Tenant @relation(
    fields: [tenantId],
    references: [id]
  )

  members ProjectMember[]
  tasks   Task[]
}

model ProjectMember {
  id        String            @id @default(uuid())
  projectId String
  userId    String
  role      ProjectRole
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  project Project @relation(
    fields: [projectId],
    references: [id]
  )

  user User @relation(
    fields: [userId],
    references: [id]
  )

  taskAssignees TaskAssignee[]

  @@unique([projectId, userId])
}
model Task {
  id          String            @id @default(uuid())
  projectId   String
  createdBy   String
  title       String
  description String?
  status   TaskStatus   @default(TODO)
  priority TaskPriority @default(MEDIUM)
  dueDate     TimestamptzString?
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  project   Project @relation(
    fields: [projectId],
    references: [id]
  )

  creator   User @relation(
    fields: [createdBy],
    references: [id]
  )

  assignees TaskAssignee[]

  @@unique([id, projectId])
}

model TaskAssignee {
  id        String            @id @default(uuid())
  taskId    String
  projectId String
  userId    String
  createdAt TimestamptzString @default(now())

  task Task @relation(
    fields: [taskId, projectId],
    references: [id, projectId]
  )

  member ProjectMember @relation(
    fields: [projectId, userId],
    references: [projectId, userId]
  )

  @@unique([taskId, userId])
}

model KnowledgeArticle {
  id          String            @id @default(uuid())
  title       String
  slug        String
  content     String
  summary     String?
  createdBy   String
  tenantId    String
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  author User @relation(
    fields: [createdBy],
    references: [id]
  )

  tenant Tenant @relation(
    fields: [tenantId],
    references: [id]
  )

  tags KnowledgeArticleTag[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Tag {
  id        String            @id @default(uuid())
  name      String
  tenantId  String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  knowledgeArticles KnowledgeArticleTag[]
  snippetTags       SnippetTag[]

  tenant Tenant @relation(
    fields: [tenantId],
    references: [id]
  )

  @@unique([tenantId, name])
  @@index([tenantId])
}

model KnowledgeArticleTag {
  id        String            @id @default(uuid())
  articleId String
  tagId     String
  createdAt TimestamptzString @default(now())

  article KnowledgeArticle @relation(
    fields: [articleId],
    references: [id]
  )

  tag Tag @relation(
    fields: [tagId],
    references: [id]
  )
  

  @@unique([articleId, tagId])
}

model CodeSnippet {
  id          String            @id @default(uuid())
  title       String
  language    String
  code        String
  description String?
  createdBy   String
  tenantId    String
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  author User @relation(
    fields: [createdBy],
    references: [id]
  )

  tenant Tenant @relation(
    fields: [tenantId],
    references: [id]
  )

  tags SnippetTag[]

  @@index([tenantId])
}

model SnippetTag {
  id        String            @id @default(uuid())
  snippetId String
  tagId     String
  createdAt TimestamptzString @default(now())

  snippet CodeSnippet @relation(
    fields: [snippetId],
    references: [id]
  )

  tag Tag @relation(
    fields: [tagId],
    references: [id]
  )

  @@unique([snippetId, tagId])
}

model Document {
  id          String            @id @default(uuid())
  title       String
  description String?
  fileName    String
  filePath    String
  mimeType    String
  fileSize    String
  createdBy   String
  tenantId    String
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  creator User @relation(
    fields: [createdBy],
    references: [id]
  )

  tenant Tenant @relation(
    fields: [tenantId],
    references: [id]
  )

  @@index([tenantId])
}


enum SubscriptionBillingPeriod {
  MONTHLY
  YEARLY
}

enum SubscriptionFeatureValueType {
  BOOLEAN
  LIMIT
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum DiscountDuration {
  ONCE
  RECURRING_CYCLES
  FOREVER
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED
}

enum PaymentProviderType {
  SANDBOX
  MIDTRANS
  XENDIT
}

model SubscriptionPackage {
  id          String            @id @default(uuid())
  code        String            @unique
  name        String
  description String?
  isActive    Boolean           @default(true)
  sortOrder   Int               @default(0)
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  prices        SubscriptionPackagePrice[]
  features      SubscriptionPackageFeature[]
  discounts     DiscountPackage[]
  subscriptions TenantSubscription[]

  @@index([isActive, sortOrder])
}

model SubscriptionFeature {
  id          String                         @id @default(uuid())
  code        String                         @unique
  name        String
  description String?
  valueType   SubscriptionFeatureValueType
  unit        String?
  isActive    Boolean                        @default(true)
  createdAt   TimestamptzString              @default(now())
  updatedAt   temporal.updatedAtString()

  packageFeatures SubscriptionPackageFeature[]

  @@index([isActive])
}

model SubscriptionPackageFeature {
  id         String            @id @default(uuid())
  packageId  String
  featureId  String
  enabled    Boolean           @default(false)
  limitValue Int?
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()

  package SubscriptionPackage @relation(fields: [packageId], references: [id])
  feature SubscriptionFeature @relation(fields: [featureId], references: [id])

  @@unique([packageId, featureId])
  @@index([featureId])
}

model SubscriptionPackagePrice {
  id            String                    @id @default(uuid())
  packageId     String
  version       Int                       @default(1)
  billingPeriod SubscriptionBillingPeriod
  amountMinor   Int
  currency      String                    @default("IDR")
  isActive      Boolean                   @default(true)
  createdAt     TimestamptzString         @default(now())
  updatedAt     temporal.updatedAtString()

  package       SubscriptionPackage @relation(fields: [packageId], references: [id])
  subscriptions TenantSubscription[]
  invoices      SubscriptionInvoice[]

  @@unique([packageId, billingPeriod, version])
  @@index([packageId, billingPeriod, isActive])
}

model Discount {
  id                 String            @id @default(uuid())
  code               String            @unique
  name               String
  description        String?
  type               DiscountType
  valueMinor         Int?
  percentage         Int?
  maxDiscountMinor   Int?
  minimumAmountMinor Int?
  duration           DiscountDuration @default(ONCE)
  durationCycles     Int?
  usageLimit         Int?
  usageCount        Int               @default(0)
  startsAt           TimestamptzString?
  expiresAt          TimestamptzString?
  isActive           Boolean           @default(true)
  createdAt          TimestamptzString @default(now())
  updatedAt          temporal.updatedAtString()

  packages         DiscountPackage[]
  usages           DiscountUsage[]
  invoiceDiscounts InvoiceDiscount[]
}

model DiscountPackage {
  id         String            @id @default(uuid())
  discountId String
  packageId  String
  createdAt  TimestamptzString @default(now())

  discount Discount            @relation(fields: [discountId], references: [id])
  package  SubscriptionPackage @relation(fields: [packageId], references: [id])

  @@unique([discountId, packageId])
  @@index([packageId])
}

model TenantSubscription {
  id                     String              @id @default(uuid())
  tenantId               String
  packageId              String
  packagePriceId         String
  status                 SubscriptionStatus
  provider               PaymentProviderType @default(SANDBOX)
  providerCustomerId     String?
  providerSubscriptionId String?
  startedAt              TimestamptzString
  currentPeriodStart     TimestamptzString
  currentPeriodEnd       TimestamptzString
  cancelledAt            TimestamptzString?
  createdAt              TimestamptzString @default(now())
  updatedAt              temporal.updatedAtString()

  tenant          Tenant                   @relation(fields: [tenantId], references: [id])
  package         SubscriptionPackage      @relation(fields: [packageId], references: [id])
  packagePrice    SubscriptionPackagePrice @relation(fields: [packagePriceId], references: [id])
  invoices        SubscriptionInvoice[]
  payments        Payment[]
  discountUsages  DiscountUsage[]

  @@index([tenantId, status])
  @@index([packageId])
  @@index([providerSubscriptionId])
}

model SubscriptionInvoice {
  id                  String                     @id @default(uuid())
  tenantId            String
  subscriptionId      String
  packagePriceId      String
  packageCode         String
  packageName         String
  billingPeriod       SubscriptionBillingPeriod
  currency            String
  originalAmountMinor Int
  discountAmountMinor Int                        @default(0)
  taxAmountMinor      Int                        @default(0)
  finalAmountMinor    Int
  status              PaymentStatus              @default(PENDING)
  issuedAt            TimestamptzString          @default(now())
  paidAt              TimestamptString?
  dueAt               TimestamptString?
  createdAt           TimestamptString           @default(now())
  updatedAt           temporal.updatedAtString()

  tenant         Tenant                   @relation(fields: [tenantId], references: [id])
  subscription   TenantSubscription       @relation(fields: [subscriptionId], references: [id])
  packagePrice   SubscriptionPackagePrice @relation(fields: [packagePriceId], references: [id])
  discounts      InvoiceDiscount[]
  discountUsages DiscountUsage[]
  payments       Payment[]

  @@index([tenantId, status])
  @@index([subscriptionId])
}

model InvoiceDiscount {
  id                 String            @id @default(uuid())
  invoiceId          String
  discountId         String
  codeSnapshot       String
  discountType       DiscountType
  discountValueMinor Int?
  discountPercentage Int?
  amountMinor        Int
  createdAt          TimestamptString @default(now())

  invoice  SubscriptionInvoice @relation(fields: [invoiceId], references: [id])
  discount Discount            @relation(fields: [discountId], references: [id])

  @@index([discountId])
  @@unique([invoiceId, discountId])
}

model DiscountUsage {
  id             String            @id @default(uuid())
  discountId     String
  tenantId       String
  subscriptionId String?
  invoiceId      String?
  usedAt         TimestamptString @default(now())

  discount     Discount             @relation(fields: [discountId], references: [id])
  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  subscription TenantSubscription?  @relation(fields: [subscriptionId], references: [id])
  invoice      SubscriptionInvoice? @relation(fields: [invoiceId], references: [id])

  @@index([discountId, tenantId])
  @@index([tenantId])
}

model Payment {
  id                     String              @id @default(uuid())
  tenantId               String
  subscriptionId         String
  invoiceId              String
  provider               PaymentProviderType @default(SANDBOX)
  providerPaymentId      String?
  status                 PaymentStatus       @default(PENDING)
  amountMinor            Int
  currency               String              @default("IDR")
  checkoutUrl            String?
  paidAt                 TimestamptString?
  expiresAt              TimestamptString?
  createdAt              TimestamptString    @default(now())
  updatedAt              temporal.updatedAtString()

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  subscription TenantSubscription @relation(fields: [subscriptionId], references: [id])
  invoice      SubscriptionInvoice @relation(fields: [invoiceId], references: [id])

  @@index([tenantId, status])
  @@index([provider, providerPaymentId])
  @@index([invoiceId])
}
